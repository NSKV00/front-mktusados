<template>
  <div>
    <v-app-bar app flat elevation="1" color="white" class="header-container">
      <!-- Faixa Top (opcional) -->
      <v-row class="header-top d-none d-md-flex px-6 py-1 bg-grey-lighten-4 text-grey-darken-2" align="center" justify="end">
        <RouterLink to="/ajuda" class="link-top mx-3">Ajuda</RouterLink>
        <RouterLink to="/sobre" class="link-top mx-3">Sobre Nós</RouterLink>
        <RouterLink to="/promocoes" class="link-top mx-3 text-primary font-medium">Ofertas</RouterLink>
      </v-row>

      <!-- Barra principal -->
      <v-row class="px-4" align="center" justify="space-between" no-gutters>
        <v-col cols="auto" class="d-flex align-center">
          <RouterLink to="/">
            <v-img :src="logo" width="130" alt="Logo" class="cursor-pointer" />
          </RouterLink>
        </v-col>

        <v-col cols="12" md="6" class="d-none d-md-flex justify-center">
          <v-text-field
            v-model="search"
            placeholder="Buscar produtos, serviços..."
            prepend-inner-icon="mdi-magnify"
            hide-details
            variant="outlined"
            rounded="xl"
            density="comfortable"
            class="search-field"
            @keydown.enter="emitirBusca"
          />
        </v-col>

        <v-col cols="auto" class="d-flex align-center gap-3">
          <v-btn icon class="icon-btn" @click="irFavoritos">
            <v-icon>mdi-heart-outline</v-icon>
          </v-btn>

          <v-btn icon class="icon-btn" @click="irCarrinho">
            <v-badge :content="cartCount" color="primary" v-if="cartCount > 0">
              <v-icon>mdi-cart-outline</v-icon>
            </v-badge>
            <v-icon v-else>mdi-cart-outline</v-icon>
          </v-btn>

          <!-- Avatar / Menu usuário -->
          <v-menu v-model="menuUsuario" offset-y transition="slide-y-transition" :close-on-content-click="false">
            <template #activator="{ props }">
              <v-avatar v-bind="props" class="cursor-pointer" size="38">
                <v-img :src="fotoPerfil" alt="Usuário" />
              </v-avatar>
            </template>

            <v-card width="280" elevation="3">
              <v-card-text v-if="cliente.length > 0" class="text-center py-3">
                <v-avatar size="70" class="mx-auto mb-2">
                  <v-img :src="fotoPerfil" alt="Foto de perfil" @click="abrirUpload" class="cursor-pointer" />
                </v-avatar>

                <div class="font-weight-medium">{{ cliente[0]?.nome || cliente[0]?.email }}</div>

                <v-btn text color="primary" size="small" @click="abrirUpload">Trocar Foto</v-btn>

                <input ref="inputFile" type="file" accept="image/*" class="hidden" @change="handleFotoChange" />
              </v-card-text>

              <v-divider />

              <v-list density="compact">
                <v-list-item v-if="cliente[0]?.ativo" :to="{ path: '/meusAgendamentos' }" prepend-icon="mdi-calendar-check" title="Meus Agendamentos" />
                <template v-if="cliente[0]?.admin">
                  <v-list-item :to="{ path: '/clientes' }" title="Clientes" prepend-icon="mdi-account-group" />
                  <v-list-item :to="{ path: '/agendamentos' }" title="Agendamentos" prepend-icon="mdi-clock" />
                  <v-list-item :to="{ path: '/funcionarios' }" title="Funcionários" prepend-icon="mdi-briefcase-account" />
                  <v-list-item :to="{ path: '/semana' }" title="Semana" prepend-icon="mdi-calendar" />
                </template>

                <v-divider />

                <v-list-item v-if="cliente.length > 0" @click="logout" title="Logout" prepend-icon="mdi-logout" />
                <v-list-item v-else :to="{ path: '/login' }" title="Login" prepend-icon="mdi-login" />
              </v-list>
            </v-card>
          </v-menu>

          <!-- Mobile nav icon (redundante, mas garante funcionalidade) -->
          <v-app-bar-nav-icon class="d-md-none" @click="drawer = !drawer" />
        </v-col>
      </v-row>
    </v-app-bar>

    <!-- Drawer para mobile -->
    <v-navigation-drawer v-model="drawer" temporary app color="white">
      <v-list nav dense>
        <v-list-item :to="{ path: '/' }" title="Home" prepend-icon="mdi-home" />
        <v-list-item :to="{ path: '/agendamento' }" title="Agendamento" prepend-icon="mdi-notebook" />
        <v-list-item :to="{ path: '/servicos' }" title="Serviços" prepend-icon="mdi-scissors-cutting" />
        <v-divider />
        <v-list-item :to="{ path: '/promocoes' }" title="Ofertas" prepend-icon="mdi-tag" />
      </v-list>
    </v-navigation-drawer>
  </div>
</template>

<script setup lang="ts">
import { ref, onMounted } from 'vue'
import { useRouter, RouterLink } from 'vue-router'
import { toast } from 'vue3-toastify'
import logo from '../assets/Logo.png'
import api from '../controller/api'

const router = useRouter()

interface returnUser {
  id: number
  nome: string
  email: string
  admin: boolean
  ativo: boolean
  imagem?: string
}

const drawer = ref(false)
const menuUsuario = ref(false)
const cliente = ref<returnUser[]>([])
const inputFile = ref<HTMLInputElement | null>(null)
const fotoPerfil = ref<string>('/default-profile.png')
const cartCount = ref(0)
const search = ref('')

/** Tenta pegar usuário do localStorage (compatível com 'usuario' ou 'user') */
const pegarUsuario = async () => {
  try {
    const raw = localStorage.getItem('usuario') ?? localStorage.getItem('user')
    if (!raw) {
      cliente.value = []
      fotoPerfil.value = '/default-profile.png'
      return
    }

    const parsed = JSON.parse(raw)
    const id = parsed?.id ?? parsed?.usuario?.id
    if (!id) return

    // Ajuste: endpoint '/usuario' pode retornar objeto ou array — trate ambos
    const resp = await api.get('/usuario', { params: { id } })
    const data = resp.data

    if (Array.isArray(data)) {
      cliente.value = data
      fotoPerfil.value = data[0]?.imagem ? `data:image/png;base64,${data[0].imagem}` : '/default-profile.png'
    } else if (data && (data.usuario || data.id)) {
      // Se backend retornar { usuario: {...} } ou um objeto único
      const u = Array.isArray(data.usuario) ? data.usuario[0] : (data.usuario ?? data)
      cliente.value = u ? [u] : []
      fotoPerfil.value = u?.imagem ? `data:image/png;base64,${u.imagem}` : '/default-profile.png'
    } else {
      cliente.value = []
      fotoPerfil.value = '/default-profile.png'
    }
  } catch (err) {
    console.error('Erro pegarUsuario:', err)
    cliente.value = []
    fotoPerfil.value = '/default-profile.png'
  }
}

const abrirUpload = () => {
  inputFile.value?.click()
}

const handleFotoChange = async (e: Event) => {
  const target = e.target as HTMLInputElement
  if (!target?.files?.[0]) return

  const file = target.files[0]
  try {
    const formData = new FormData()
    formData.append('imagem', file)

    const raw = localStorage.getItem('usuario') ?? localStorage.getItem('user')
    if (!raw) throw new Error('Usuário não encontrado no localStorage')

    const { id } = JSON.parse(raw)
    if (!id) throw new Error('ID do usuário ausente')

    await api.patch(`/usuario/${id}`, formData, {
      headers: { 'Content-Type': 'multipart/form-data' },
    })

    toast.success('Foto atualizada com sucesso!')
    await pegarUsuario()
  } catch (err) {
    console.error('Erro handleFotoChange:', err)
    toast.error('Erro ao salvar foto.')
  }
}

const logout = () => {
  localStorage.removeItem('token')
  localStorage.removeItem('usuario')
  localStorage.removeItem('user')
  // redireciona ao login
  router.push('/login').catch(() => { window.location.href = '/login' })
}

const emitirBusca = () => {
  // exemplo: redireciona para página de busca com query
  if ((search.value || '').trim().length === 0) return
  router.push({ path: '/busca', query: { q: search.value } })
}

const irCarrinho = () => router.push('/carrinho')
const irFavoritos = () => router.push('/favoritos')

onMounted(() => {
  pegarUsuario()
  // carregar carrinho de exemplo
  try {
    const cart = JSON.parse(localStorage.getItem('cart') || '[]')
    cartCount.value = Array.isArray(cart) ? cart.length : 0
  } catch {
    cartCount.value = 0
  }
})
</script>

<style scoped>
.header-container { border-bottom: 1px solid #e9e9e9; }
.link-top { font-size: 0.85rem; color: #555; text-decoration: none; }
.link-top:hover { color: var(--v-theme-primary); }
.search-field { max-width: 640px; }
.icon-btn { color: #444; transition: color 0.2s; }
.icon-btn:hover { color: var(--v-theme-primary); }
.hidden { display: none; }
.cursor-pointer { cursor: pointer; }
</style>